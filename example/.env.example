# Local runs: copy to .env and export it, then `go run .`
OTEL_SERVICE_NAME=otelkit-example
DEPLOYMENT_ENVIRONMENT=development

# otlp | stdout | none
OTEL_EXPORTER=none

# Used only when OTEL_EXPORTER=otlp and you set it explicitly.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:5080/api/default
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20cm9vdEBleGFtcGxlLmNvbTpDb21wbGV4cGFzcyMxMjM=

# Simulated services.
GATEWAY_ADDR=:8080
USERS_ADDR=:8081
ORDERS_ADDR=:8082
USERS_URL=http://localhost:8081
ORDERS_URL=http://localhost:8082

# OpenObserve API (log ingest and SQL search).
OPENOBSERVE_URL=http://localhost:5080
OPENOBSERVE_ORG=default
OPENOBSERVE_USER=root@example.com
OPENOBSERVE_PASSWORD=Complexpass#123
OPENOBSERVE_STREAM=example_logs
